{
  "name": "project-doc",
  "version": "0.2.0",
  "description": "让文档追着代码跑 - Claude Code 项目治理插件",
  "rulesPath": ".opencode/rules",
  "skillsPath": ".opencode/skills",
  "skills": {
    "project-init": {
      "path": "skills/project-init/SKILL.md",
      "userInvocable": true,
      "trigger": "manual"
    },
    "requirement-change": {
      "path": "skills/requirement-change/SKILL.md",
      "userInvocable": true,
      "trigger": "manual"
    },
    "task-update": {
      "path": "skills/task-update/SKILL.md",
      "userInvocable": false,
      "trigger": "lifecycle"
    },
    "doc-sync": {
      "path": "skills/doc-sync/SKILL.md",
      "userInvocable": false,
      "trigger": "file-change"
    }
  }
}